{
  "version": 2,
  "layers": {
    "architecture": {
      "label": "architecture (架构层)",
      "params": {
        "tiles": {
          "kind": "int",
          "values": [
            1,
            2,
            4,
            8
          ],
          "step": 1,
          "map": [
            "arch",
            "system",
            "tiles"
          ],
          "refine": false
        },
        "cores_per_tile": {
          "kind": "int",
          "values": [
            1,
            2,
            4
          ],
          "step": 1,
          "map": [
            "arch",
            "system",
            "cores_per_tile"
          ],
          "refine": false
        },
        "dataflow": {
          "kind": "enum",
          "values": [
            "output_stationary",
            "weight_stationary",
            "input_stationary"
          ],
          "map": [
            "arch",
            "system",
            "dataflow"
          ]
        },
        "precision_in_bit": {
          "kind": "bits",
          "values": [
            2,
            4,
            8
          ],
          "map": [
            "arch",
            "optical_core",
            "precision",
            "in_bit"
          ],
          "refine": false,
          "constraint": "in_bit <= dac.prec"
        },
        "precision_w_bit": {
          "kind": "bits",
          "values": [
            2,
            4,
            8
          ],
          "map": [
            "arch",
            "optical_core",
            "precision",
            "w_bit"
          ],
          "refine": false
        },
        "precision_out_bit": {
          "kind": "bits",
          "values": [
            2,
            4,
            8
          ],
          "map": [
            "arch",
            "optical_core",
            "precision",
            "out_bit"
          ],
          "refine": false,
          "constraint": "out_bit <= adc.prec"
        },
        "hbm_bandwidth": {
          "kind": "int",
          "values": [
            512,
            1024,
            2048
          ],
          "step": 128,
          "map": [
            "arch",
            "memory",
            "HBM",
            "bandwidth"
          ],
          "refine": true
        },
        "glb1_cache_size": {
          "kind": "int",
          "values": [
            64,
            256,
            485,
            1024,
            4096
          ],
          "step": 64,
          "map": [
            "arch",
            "memory",
            "GLB1",
            "cache_size"
          ],
          "refine": true
        },
        "glb2_cache_size": {
          "kind": "int",
          "values": [
            64,
            256,
            485,
            1024,
            4096
          ],
          "step": 64,
          "map": [
            "arch",
            "memory",
            "GLB2",
            "cache_size"
          ],
          "refine": true
        },
        "rf_cache_size": {
          "kind": "int",
          "values": [
            64,
            256,
            485,
            1024,
            4096
          ],
          "step": 64,
          "map": [
            "arch",
            "memory",
            "RF",
            "cache_size"
          ],
          "refine": true
        },
        "core_height": {
          "kind": "int",
          "values": [
            8,
            12,
            16
          ],
          "step": 2,
          "map": [
            "arch",
            "optical_core",
            "height"
          ],
          "refine": true
        },
        "core_width": {
          "kind": "int",
          "values": [
            8,
            12,
            16
          ],
          "step": 2,
          "map": [
            "arch",
            "optical_core",
            "width"
          ],
          "refine": true
        },
        "num_wavelength": {
          "kind": "int",
          "values": [
            8,
            12,
            16
          ],
          "step": 2,
          "map": [
            "arch",
            "optical_core",
            "num_wavelength"
          ],
          "refine": true
        },
        "work_freq": {
          "kind": "int",
          "values": [
            5,
            10,
            15,
            20,
            25
          ],
          "step": 5,
          "map": [
            "arch",
            "optical_core",
            "work_freq"
          ],
          "refine": true,
          "constraint": "work_freq <= mzm.symbol_rate"
        }
      }
    },
    "topology": {
      "label": "topology (拓扑与电路层)",
      "params": {
        "core_kind": {
          "kind": "enum",
          "map": [
            "arch",
            "topology",
            "core_kind"
          ],
          "note": "电路结构选择器。候选不在本文件声明——它们由拓扑注册表 photon_tuner/core/topology_space.py 的 CORE_KINDS 派生（evaluable=True 的全部），因为那里同时承载 real/evaluable 标志、core→node 耦合矩阵与器件槽位。本文件若重复列出会静默漂移，故加载时注入；显式写错会直接报错。",
          "_derived_from": "topology_space.CORE_KINDS (evaluable=True)"
        },
        "node_kind": {
          "kind": "enum",
          "map": [
            "arch",
            "topology",
            "node_kind"
          ],
          "note": "节点结构选择器。候选由 topology_space.NODE_KINDS 派生（dode / tunable_mzi / weight_mrr / pcm_cell / wdm_modulator），本文件不重复声明。",
          "_derived_from": "topology_space.NODE_KINDS (evaluable=True)"
        },
        "sharing_policy": {
          "kind": "enum",
          "values": [
            "no_sharing",
            "adc_shared",
            "adc_tia_shared"
          ],
          "map": [
            "arch",
            "topology",
            "sharing_policy"
          ]
        },
        "temporal_accum": {
          "kind": "enum",
          "values": [
            "off",
            "default",
            "deep"
          ],
          "map": [
            "arch",
            "topology",
            "temporal_accum"
          ]
        },
        "laser_distribution": {
          "kind": "enum",
          "values": [
            "H*W",
            "H*W*N",
            "H*W*N*C"
          ],
          "map": [
            "arch",
            "topology",
            "laser_distribution"
          ]
        },
        "mesh_rank": {
          "kind": "int",
          "values": [
            4,
            8,
            12,
            16,
            32
          ],
          "step": 4,
          "map": [
            "arch",
            "topology",
            "mesh_rank"
          ],
          "refine": true,
          "note": "MZI mesh 的酉变换阶数 N（N×N 矩阵，N 进 N 出）。仅 mzi_mesh_* 范式生效；dptc_crossbar 惰性。小 N = 浅 mesh、低插损、低能耗，但大矩阵需分更多块（延时高）；大 N = 深 mesh、高插损、高能耗，但一次算完（延时低）。这是光子 mesh 的经典 IL-vs-吞吐权衡轴。"
        }
      }
    },
    "device": {
      "label": "device (器件选择层)",
      "kind": "selection",
      "note": "候选由 simphony/configs/devices 运行时自动发现；下表为当前器件库中参与 core/node 网表的类型快照（实际搜索以运行时发现为准）。另外两个 params 是实例级器件类型切换（非库内器件类型）：laser_source 在片上/片外激光源间切换 i4 实例，splitter_kind 在激光分光器/1x10 MMI 间切换 i6 实例——两者保持实例编号/缩放规则/光路位置不变，只换器件类型。",
      "params": {
        "laser_source": {
          "kind": "enum",
          "values": [
            "on_chip",
            "off_chip"
          ],
          "map": [
            "devices",
            "core",
            "laser_source"
          ]
        },
        "splitter_kind": {
          "kind": "enum",
          "values": [
            "laser_splitter",
            "mmi"
          ],
          "map": [
            "devices",
            "core",
            "splitter_kind"
          ]
        }
      },
      "_device_library_snapshot": {
        "core": {
          "mzm": [
            "ACADEMIA_EO_MZM_1x1",
            "ACADEMIA_EO_MZM_2x2",
            "LT_MZM",
            "SL_MZM",
            "TFLN_MZM_HL",
            "SOH_MZM"
          ],
          "dac": [
            "DAC_1",
            "DAC_2",
            "DAC_3",
            "DAC_4",
            "DAC_5",
            "DAC_LP_28nm",
            "DAC_HS_16nm"
          ],
          "adc": [
            "ADC_SAR_1",
            "ADC_SAR_90GS",
            "ADC_SAR_4P8GS_LP",
            "ADC_SAR_2GS_LP",
            "ADC_SAR_30GS"
          ],
          "tia": [
            "TIA_1",
            "TIA_LP",
            "TIA_HB"
          ],
          "waveguide": [
            "WG_Single_Strip",
            "WG_SiN_Strip_650nm_VisNIR"
          ],
          "mrr_rerouter": [
            "LT_MRR_REROUTER",
            "MRR_THERMAL"
          ],
          "laser_splitter": [
            "Customized_Laser_Splitter"
          ],
          "micro_comb": [
            "LT_Micro_Comb",
            "MC_Si3N4_DKS_100GHz"
          ],
          "mmi": [
            "Customized_1x10_MMI"
          ],
          "on_chip_laser": [
            "Customized_Laser"
          ],
          "off_chip_laser": [
            "LT_Laser"
          ]
        },
        "node": {
          "phase_shifter": [
            "ACADEMIA_TO_PS",
            "ITO_PS",
            "MEMS_PS",
            "IHO_PS",
            "TFLN_EO_PS"
          ],
          "photodetector": [
            "ACADEMIA_Analog_PD",
            "ACADEMIA_Digital_PD",
            "LT_PD",
            "Sandia_GeWG_PD",
            "NEC_APD"
          ],
          "coupler": [
            "ACADEMIA_DC_2x2",
            "Customized_DC_2x2",
            "LT_DC_2x2",
            "CPL_MMI_SiN_Angled_PS_80x13"
          ],
          "y_branch": [
            "LT_Y_Branch",
            "YJ_Si_Compact_1p2x2"
          ]
        }
      },
      "_snapshot_note": "仅为文档快照，运行时不读取。器件变体候选由 SimPhony 器件库 YAML 在运行时发现（discover_device_catalog），因此实际可搜索集合以库为准。"
    },
    "device_param": {
      "label": "device_param (器件参数层)",
      "kind": "fixed",
      "note": "library cfgs are fixed; only variant selection is searchable"
    }
  },
  "_note": "搜索空间候选值的唯一数据源。core_kind/node_kind 的候选由 photon_tuner/core/topology_space.py 的拓扑注册表注入，不在此声明。原 mode 字段(analytic/real)已移除：仿真只走 real。"
}
