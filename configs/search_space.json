{
  "version": 2,
  "layers": {
    "architecture": {
      "label": "architecture (架构层)",
      "params": {
        "tiles": {
          "dimension": "parallelism_mapping",
          "kind": "int",
          "values": [
            1,
            2,
            4,
            8,
            16,
            32,
            64
          ],
          "step": 1,
          "map": [
            "arch",
            "system",
            "tiles"
          ],
          "refine": false
        },
        "cores_per_tile": {
          "dimension": "parallelism_mapping",
          "kind": "int",
          "values": [
            1,
            2,
            4,
            8,
            16,
            32,
            64
          ],
          "step": 1,
          "map": [
            "arch",
            "system",
            "cores_per_tile"
          ],
          "refine": false
        },
        "dataflow": {
          "dimension": "parallelism_mapping",
          "kind": "enum",
          "values": [
            "output_stationary",
            "weight_stationary",
            "input_stationary"
          ],
          "map": [
            "arch",
            "system",
            "dataflow"
          ]
        },
        "precision_in_bit": {
          "dimension": "storage_operating_point",
          "kind": "bits",
          "values": [
            2,
            4,
            8
          ],
          "map": [
            "arch",
            "optical_core",
            "precision",
            "in_bit"
          ],
          "refine": false,
          "constraint": "in_bit <= dac.prec"
        },
        "precision_w_bit": {
          "dimension": "storage_operating_point",
          "kind": "bits",
          "values": [
            2,
            4,
            8
          ],
          "map": [
            "arch",
            "optical_core",
            "precision",
            "w_bit"
          ],
          "refine": false
        },
        "precision_out_bit": {
          "dimension": "storage_operating_point",
          "kind": "bits",
          "values": [
            2,
            4,
            8
          ],
          "map": [
            "arch",
            "optical_core",
            "precision",
            "out_bit"
          ],
          "refine": false,
          "constraint": "out_bit <= adc.prec"
        },
        "hbm_bandwidth": {
          "dimension": "storage_operating_point",
          "kind": "int",
          "values": [
            512,
            1024,
            2048,
            4096
          ],
          "step": 64,
          "map": [
            "arch",
            "memory",
            "HBM",
            "bandwidth"
          ],
          "refine": true
        },
        "glb1_cache_size": {
          "dimension": "storage_operating_point",
          "kind": "int",
          "values": [
            512,
            1024,
            2048,
            4096
          ],
          "step": 64,
          "map": [
            "arch",
            "memory",
            "GLB1",
            "cache_size"
          ],
          "refine": true
        },
        "glb2_cache_size": {
          "dimension": "storage_operating_point",
          "kind": "int",
          "values": [
            512,
            1024,
            2048,
            4096
          ],
          "step": 64,
          "map": [
            "arch",
            "memory",
            "GLB2",
            "cache_size"
          ],
          "refine": true
        },
        "rf_cache_size": {
          "dimension": "storage_operating_point",
          "kind": "int",
          "values": [
            512,
            1024,
            2048,
            4096
          ],
          "step": 64,
          "map": [
            "arch",
            "memory",
            "RF",
            "cache_size"
          ],
          "refine": true
        },
        "core_height": {
          "dimension": "crossbar_scale",
          "kind": "int",
          "values": [
            8,
            16,
            32,
            64
          ],
          "step": 2,
          "map": [
            "arch",
            "optical_core",
            "height"
          ],
          "refine": true
        },
        "core_width": {
          "dimension": "crossbar_scale",
          "kind": "int",
          "values": [
            8,
            16,
            32,
            64
          ],
          "step": 2,
          "map": [
            "arch",
            "optical_core",
            "width"
          ],
          "refine": true
        },
        "num_wavelength": {
          "dimension": "crossbar_scale",
          "kind": "int",
          "values": [
            8,
            16,
            32,
            64
          ],
          "step": 2,
          "map": [
            "arch",
            "optical_core",
            "num_wavelength"
          ],
          "refine": true
        },
        "work_freq": {
          "dimension": "storage_operating_point",
          "kind": "int",
          "values": [
            2,
            4,
            8,
            16,
            32,
            64
          ],
          "step": 2,
          "map": [
            "arch",
            "optical_core",
            "work_freq"
          ],
          "refine": true,
          "constraint": "work_freq <= mzm.symbol_rate"
        }
      }
    },
    "topology": {
      "label": "topology (拓扑与电路层)",
      "params": {
        "core_kind": {
          "dimension": "core_template_scale",
          "kind": "enum",
          "map": [
            "arch",
            "topology",
            "core_kind"
          ],
          "note": "电路结构选择器。候选不在本文件声明——它们由拓扑注册表 photon_tuner/core/topology_space.py 的 CORE_KINDS 派生（evaluable=True 的全部），因为那里同时承载 real/evaluable 标志、core→node 耦合矩阵与器件槽位。本文件若重复列出会静默漂移，故加载时注入；显式写错会直接报错。",
          "_derived_from": "topology_space.CORE_KINDS (evaluable=True)"
        },
        "node_kind": {
          "dimension": "core_template_scale",
          "kind": "enum",
          "map": [
            "arch",
            "topology",
            "node_kind"
          ],
          "note": "节点结构选择器。候选由 topology_space.NODE_KINDS 派生（dode / tunable_mzi / weight_mrr / pcm_cell / wdm_modulator），本文件不重复声明。",
          "_derived_from": "topology_space.NODE_KINDS (evaluable=True)"
        },
        "sharing_policy": {
          "dimension": "circuit_organization",
          "kind": "enum",
          "values": [
            "no_sharing",
            "adc_shared",
            "adc_tia_shared"
          ],
          "map": [
            "arch",
            "topology",
            "sharing_policy"
          ]
        },
        "temporal_accum": {
          "dimension": "circuit_organization",
          "kind": "enum",
          "values": [
            "off",
            "default",
            "deep"
          ],
          "map": [
            "arch",
            "topology",
            "temporal_accum"
          ]
        },
        "laser_distribution": {
          "dimension": "circuit_organization",
          "kind": "enum",
          "values": [
            "H*W",
            "H*W*N",
            "H*W*N*C"
          ],
          "map": [
            "arch",
            "topology",
            "laser_distribution"
          ]
        },
        "mesh_rank": {
          "dimension": "core_template_scale",
          "kind": "int",
          "values": [
            4,
            8,
            12,
            16,
            32
          ],
          "step": 4,
          "map": [
            "arch",
            "topology",
            "mesh_rank"
          ],
          "refine": true,
          "note": "模板规模：在 MZI 网格中表示变换阶数，在 WDM 权重阵列中表示并行权重数；DPTC 交叉开关使用独立的阵列高、宽和波长数。"
        },
        "weight_bank_groups": {
          "dimension": "circuit_organization",
          "kind": "int",
          "values": [1, 2],
          "map": ["arch", "topology", "weight_bank_groups"],
          "note": "仅 MRR 权重组支持并行读出分组。双组要求总波长数为偶数且不小于 2，平分波长后各自读出部分和并进行数字归约。"
        }
      }
    },
    "device": {
      "label": "device (器件选择层)",
      "kind": "selection",
      "note": "库内变体由运行时发现，按活动槽位选用。laser_source 和 splitter_kind 分别切换 DPTC 网表中 i4、i6 的器件类型，通过器件编辑工具提交。",
      "params": {
        "laser_source": {
          "dimension": "slot_selection",
          "edit_tool": "modify_device_parameter",
          "kind": "enum",
          "values": [
            "on_chip",
            "off_chip"
          ],
          "map": [
            "devices",
            "core",
            "laser_source"
          ]
        },
        "splitter_kind": {
          "dimension": "slot_selection",
          "edit_tool": "modify_device_parameter",
          "kind": "enum",
          "values": [
            "laser_splitter",
            "mmi"
          ],
          "map": [
            "devices",
            "core",
            "splitter_kind"
          ]
        }
      },
      "_device_library_snapshot": {
        "core": {
          "mzm": [
            "ACADEMIA_EO_MZM_1x1",
            "ACADEMIA_EO_MZM_2x2",
            "LT_MZM",
            "SL_MZM",
            "TFLN_MZM_HL",
            "SOH_MZM"
          ],
          "dac": [
            "DAC_1",
            "DAC_2",
            "DAC_3",
            "DAC_4",
            "DAC_5",
            "DAC_LP_28nm",
            "DAC_HS_16nm"
          ],
          "adc": [
            "ADC_SAR_1",
            "ADC_SAR_90GS",
            "ADC_SAR_4P8GS_LP",
            "ADC_SAR_2GS_LP",
            "ADC_SAR_30GS"
          ],
          "tia": [
            "TIA_1",
            "TIA_LP",
            "TIA_HB"
          ],
          "waveguide": [
            "WG_Single_Strip",
            "WG_SiN_Strip_650nm_VisNIR"
          ],
          "mrr_rerouter": [
            "LT_MRR_REROUTER",
            "MRR_THERMAL"
          ],
          "laser_splitter": [
            "Customized_Laser_Splitter"
          ],
          "micro_comb": [
            "LT_Micro_Comb",
            "MC_Si3N4_DKS_100GHz"
          ],
          "mmi": [
            "Customized_1x10_MMI"
          ],
          "on_chip_laser": [
            "Customized_Laser"
          ],
          "off_chip_laser": [
            "LT_Laser"
          ]
        },
        "node": {
          "phase_shifter": [
            "ACADEMIA_TO_PS",
            "ITO_PS",
            "MEMS_PS",
            "IHO_PS",
            "TFLN_EO_PS"
          ],
          "photodetector": [
            "ACADEMIA_Analog_PD",
            "ACADEMIA_Digital_PD",
            "LT_PD",
            "Sandia_GeWG_PD",
            "NEC_APD"
          ],
          "coupler": [
            "ACADEMIA_DC_2x2",
            "Customized_DC_2x2",
            "LT_DC_2x2",
            "CPL_MMI_SiN_Angled_PS_80x13"
          ],
          "y_branch": [
            "LT_Y_Branch",
            "YJ_Si_Compact_1p2x2"
          ]
        }
      },
      "_snapshot_note": "仅为文档快照，运行时不读取。器件变体候选由 SimPhony 器件库 YAML 在运行时发现（discover_device_catalog），因此实际可搜索集合以库为准。"
    },
    "device_param": {
      "label": "device_param (器件参数层)",
      "kind": "fixed",
      "note": "library cfgs are fixed; only variant selection is searchable"
    }
  },
  "_note": "搜索空间候选值的唯一数据源。core_kind/node_kind 的候选由 photon_tuner/core/topology_space.py 的拓扑注册表注入，不在此声明。原 mode 字段(analytic/real)已移除：仿真只走 real。",
  "_notes": {
    "architecture_powers_of_two": "架构层的几何/内存/频率轴一律取 2 的幂，上限至少到 64，保证同一拓扑族下有足够密的邻域可走。精度轴保持 2/4/8 bit：上界由 DAC/ADC 的 prec 与 sample_rate 链物理给定，扩到 64 bit 不可仿真。",
    "cache_lower_bound": "三级缓存的候选下界为 512 KB：CACTI 在给定的 block_size/associativity 下对 64/128/256 KB 无解（'Invalid memory configuration provided for GLB1'）。这是后端建模能力的边界，而非物理上不存在。若要搜索更小的缓存，需要更换存储模型或放宽 associativity 约束，不能只把数字加回候选表。"
  }
}
